# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# SQLite Database
db.sqlite3
db.sqlite3-journal

# Environment variables (keep .env.example)
.env
.env.*
!.env.example

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
bin/
bin.bak/
pyvenv.cfg

# Migrations
*/migrations/*
!**/migrations
!**/migrations/__init__.py

# User-uploaded media
media/

# Collected static files (python manage.py collectstatic)
staticfiles/

# Logs
*.log

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# IDE / editor
.vscode/
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db
desktop.ini
